<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- to offer «uninstall» on an app: Android itself asks the owner to confirm -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- updates from tilfazi's releases: Android's installer still asks the owner -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- the owner's own photos, from a folder named «Tilfazi» on the TV or a USB drive -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- the apps the home screen lists: whatever a TV or a phone launcher would open -->
    <queries>
        <!-- the TV's own viewers, to hand a source to when tilfazi's cannot show it -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="android.media.tv" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.droidlogic.tvsource" />
        <package android:name="com.droidlogic.android.tv" />
        <package android:name="com.droidlogic.tv" />
        <package android:name="com.android.tv" />
        <package android:name="com.google.android.apps.tv.launcherx" />
        <package android:name="com.google.android.tvlauncher" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TilfaziApp"
        android:label="@string/app_name"
        android:icon="@drawable/mark"
        android:banner="@drawable/banner"
        android:supportsRtl="true"
        android:theme="@style/Tilfazi">

        <activity
            android:name=".home.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- tilfazi as the TV's home: an alias so the settings can switch it off and hand the home back to the TV -->
        <activity-alias
            android:name=".home.AsHome"
            android:targetActivity=".home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".home.InputActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <activity
            android:name=".setup.SetupActivity"
            android:exported="true"
            android:label="@string/setup_title"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ambient.AmbientActivity"
            android:exported="true"
            android:screenOrientation="landscape" />

        <service
            android:name=".ambient.AmbientDream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/ambient" />
        </service>

        <!-- setup from a computer: only the adb shell holds DUMP, so no other app can change the settings -->
        <receiver
            android:name=".setup.AdbSetup"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.tilfazi.tv.CONFIG" />
            </intent-filter>
        </receiver>
        <receiver android:name=".feed.Updater$Done" android:exported="false" />
    </application>
</manifest>
